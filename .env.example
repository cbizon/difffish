# Copy to .env and fill in. Never commit .env.
# The API key does not go here: it is read from the macOS keychain item "azure-openai".

# Azure OpenAI's OpenAI-compatible endpoint
AZURE_OPENAI_URL=https://<resource>.openai.azure.com/openai/v1

# Directory holding WCS-NNNN.pdf
DIFFFISH_NOTES_DIR=/path/to/foundry/WCS field notes

# Vision models that read the document (comma-separated deployment names)
DIFFFISH_READER_MODELS=gpt-4.1,gpt-4.1-mini,gpt-5
# Reconciles the readers. Never sees the document.
DIFFFISH_ADJUDICATOR_MODEL=
# Compares a transcription with the human record. Use a different model from the adjudicator.
DIFFFISH_SCORER_MODEL=

# Optional settings (defaults shown)
# DIFFFISH_MIN_READERS=3
# DIFFFISH_DPI=200
# STRUCTURED_OUTPUT_METHOD=function_calling
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT=300
